# Copy this file to ".env" (ignored by git) and fill in your own values:
#     cp .env.example .env
# The app and all scripts read ".env" on start. A variable that is already set
# in the shell wins over the file. Empty values are ignored.
# Never commit ".env" and never paste the token into code, issues or chat.

# Earthdata Login token, needed for live mode and scripts/build_cache.py.
# Get it at https://urs.earthdata.nasa.gov/ -> log in -> "Generate Token"
# -> "Generate Token" -> "Show Token". Valid for 60 days; max. two at once.
# Also approve "NASA GESDISC DATA ARCHIVE" once under
# Applications -> Authorized Apps -> Approve More Applications, and for the MODIS
# cloud properties "LAADS DAAC" (or log in once at https://ladsweb.modaps.eosdis.nasa.gov/).
EARTHDATA_TOKEN=

# Earthdata Login username and password (same account as the token). Needed only
# where a service does not accept the token: AppEEARS (snow albedo) logs in with
# them; earthaccess can use them too. Put the password in single quotes if it
# contains a space or "#":  EARTHDATA_PASSWORD='my pass#word'
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# EODMS account (Natural Resources Canada, https://www.eodms-sgdot.nrcan-rncan.gc.ca/):
# RADARSAT/RCM search and orders use the username and password directly (HTTP basic
# auth); there is no token. Not needed by the app; listing collections works without.
EODMS_USER=
EODMS_PASS=

# May the app fetch data from NASA itself? (needs EARTHDATA_TOKEN)
#   off      read the offline cache only (default; demos, pitch, judges)
#   missing  fetch series an analysis needs but the cache lacks, then save them
#   refresh  like missing, plus a button "Update this analysis from NASA"
# The whole record of a product is fetched: seconds for daily OMI, about
# 10-15 minutes per region for MERRA-2 (since 1980).
# ETD_FETCH=missing

# Files read at the same time by the earthaccess route (MODIS clouds, OCO-2), each in
# its own process. Reading is limited by network latency, not bandwidth: 6 workers
# take ~15 min for the whole MODIS cloud record, 1 = one file after the other.
# Be fair to NASA's servers; more than ~12 brings little.
# ETD_WORKERS=6

# Optional: other folders for the data cache and the catalog.
# ETD_DATA_DIR=data/synthetic
# ETD_CATALOG_DIR=catalog
